{
  "name": "poker-app",
  "version": "1.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/cli": "^56.1.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "expo": "~54.0.0",
    "expo-av": "^16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "tsc src/__tests__/handEvaluator.test.ts src/__tests__/gameEngine.test.ts --outDir /tmp/poker-app-tests --module commonjs --target ES2020 --esModuleInterop --skipLibCheck && node /tmp/poker-app-tests/__tests__/handEvaluator.test.js && node /tmp/poker-app-tests/__tests__/gameEngine.test.js"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  },
  "private": true
}
