{
  "expo": {
    "name": "Mocha River",
    "slug": "mocha-river",
    "version": "3.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D0D0D"
    },
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stitchace.poker"
    },
    "android": {
      "package": "com.stitchace.poker",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      "expo-asset",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "f19311af-be1c-4016-a2f0-4e938fc7e483"
      }
    },
    "owner": "onecode311"
  }
}
